# Copy to .env and fill in the empty values. Never commit .env.

# PostgreSQL — matches the `db` service of docker-compose.yml (local dev only)
DATABASE_URL="postgresql://docbot:docbot@localhost:5432/docbot"

# Session signing key, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Admin account created/updated by the seed (`npx prisma db seed`, also run at container start)
ADMIN_EMAIL="admin@example.com"
# At least 12 characters
ADMIN_PASSWORD=""

# LLM provider: "mock" (no API key, deterministic) or "anthropic"
LLM_PROVIDER="mock"

# Only used when LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Search: "fulltext" (PostgreSQL full-text only) or "hybrid" (full-text + embeddings, RRF fusion).
# hybrid needs pgvector, the model files (`npm run model:download`) and computed embeddings
# (`npm run embeddings:backfill`). Everything runs locally: no API key, no network.
SEARCH_MODE="fulltext"
# hybrid only: vector results under this cosine similarity are ignored, so an off-topic
# question still gets zero passages (refusal without calling the LLM).
VECTOR_MIN_SIMILARITY="0.853"
# "true": add the long form of medical abbreviations (IDM, IRM, AVC…) to the question
# before searching (src/lib/search/abbreviations.ts). Off by default.
MEDICAL_ABBREVIATIONS="false"

# Embedding model (optional): Hugging Face id and local folder of its files
EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDING_MODEL_DIR=".models"
