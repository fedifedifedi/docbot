generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum DocumentSource {
  PASTE
  FILE
}

model Document {
  id        String         @id @default(cuid())
  title     String
  source    DocumentSource
  filename  String?
  content   String
  createdAt DateTime       @default(now()) @map("created_at")
  chunks    Chunk[]

  @@index([createdAt])
  @@map("documents")
}

model Chunk {
  id         String                   @id @default(cuid())
  documentId String                   @map("document_id")
  document   Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  /// Full-text vector, generated by PostgreSQL from `content` (see the chunk_fts migration):
  /// to_tsvector('docbot_fr', content) — French stemming + accent folding. Never written by the app.
  /// The dbgenerated() mirrors the GENERATED expression so Prisma sees no drift.
  tsv        Unsupported("tsvector")? @default(dbgenerated("to_tsvector('docbot_fr'::regconfig, content)"))
  /// Embedding of the chunk (pgvector, 384 dimensions, Xenova/multilingual-e5-small), see the
  /// chunk_embeddings migration. NULL until computed. The index below is HNSW (cosine) and is
  /// created by that migration's SQL: Prisma has no HNSW type, but declaring the index keeps
  /// `migrate diff` from dropping it. Always use migrations (`prisma db push` would build a
  /// B-tree index here).
  embedding  Unsupported("vector(384)")?

  @@unique([documentId, index])
  @@index([tsv], map: "chunks_tsv_idx", type: Gin)
  @@index([embedding], map: "chunks_embedding_idx")
  @@map("chunks")
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// Snapshot of cited sources ({ documentId, title, chunkIndex, excerpt }[]),
  /// kept so history stays readable after a document is deleted.
  sources        Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}
