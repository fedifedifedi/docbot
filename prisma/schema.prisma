generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum DocumentSource {
  PASTE
  FILE
}

model Document {
  id        String         @id @default(cuid())
  title     String
  source    DocumentSource
  filename  String?
  content   String
  createdAt DateTime       @default(now()) @map("created_at")
  chunks    Chunk[]

  @@index([createdAt])
  @@map("documents")
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String

  @@unique([documentId, index])
  @@map("chunks")
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// Snapshot of cited sources ({ documentId, title, chunkIndex, excerpt }[]),
  /// kept so history stays readable after a document is deleted.
  sources        Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}
